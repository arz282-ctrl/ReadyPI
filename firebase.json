{
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "ReadyPI",
        "supportEmail": "ahmedriyaz282@gmail.com"
      },
      "githubSignIn": {
        "oAuthBrandDisplayName": "ReadyPI",
        "supportEmail": "ahmedriyaz282@gmail.com"
      },
      "facebookSignIn": {
        "oAuthBrandDisplayName": "ReadyPI",
        "supportEmail": "ahmedriyaz282@gmail.com"
      },
      "appleSignIn": {
        "oAuthBrandDisplayName": "ReadyPI",
        "supportEmail": "ahmedriyaz282@gmail.com"
      }
    }
  },
  "hosting": {
    "public": "dashboard/.next/standalone",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{
          "key": "Cache-Control",
          "value": "max-age=31536000"
        }]
      }
    ]
  }
}
