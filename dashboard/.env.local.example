# =============================================================================
# ReadyPI Dashboard — Environment Variables (Supabase & Vercel)
# =============================================================================
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_ vars are exposed to the browser. Never put secrets here.

# ── Backend API ──────────────────────────────────────────────────────────────
# Local development: http://localhost:8787
# Vercel production: https://your-domain.vercel.app/api or your custom domain
NEXT_PUBLIC_API_URL=http://localhost:8787

# ── Supabase Auth & Client SDK ───────────────────────────────────────────────
# From Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Optional: Payment Gateways (Client Keys) ─────────────────────────────────
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
