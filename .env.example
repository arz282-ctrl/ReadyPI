# ReadyPi Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# SERVER CONFIG
# ============================================================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ============================================================================
# DATABASE (Supabase PostgreSQL / Connection Pooler)
# ============================================================================
# Recommended: Supabase Transaction Pooler URI (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Fallback individual variables for local dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=readypi
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# ============================================================================
# SUPABASE AUTH
# ============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# JWT SECRET (Generate with: openssl rand -base64 32)
# ============================================================================
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# ============================================================================
# API KEY ENCRYPTION
# ============================================================================
API_KEY_SALT_ROUNDS=12

# ============================================================================
# AI PROVIDER API KEYS
# ============================================================================

# Groq (Free tier - Llama 3 70B)
GROQ_API_KEY=your_groq_api_key

# Google AI Studio (Free tier - Gemini 1.5 Flash)
GOOGLE_API_KEY=your_google_ai_studio_key

# DeepSeek (Paid - cheapest model)
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenAI (Paid - GPT-4o, GPT-4o Mini)
OPENAI_API_KEY=your_openai_api_key

# Anthropic (Paid - Claude Sonnet, Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Mistral (Paid - Mistral Small)
MISTRAL_API_KEY=your_mistral_api_key

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================

# Razorpay (Primary — UPI, PhonePe, Google Pay, Paytm, Net Banking, Cards)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Manual UPI (INR QR code / UPI ID transfer, admin-verified)
UPI_ID=your_upi_id@bank
UPI_PAYEE_NAME=Your Business Name
ADMIN_EMAIL=your_admin_email@example.com

# NOWPayments (USDT TRC20 Crypto)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_PUBLIC_KEY=your_nowpayments_public_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
SANDBOX_MODE=true

# Stripe (Global card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── Legacy (Bangladesh) — kept for existing customers during the India migration ───
# SSLCommerz (bKash, Nagad, Rocket, Cards)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/api/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/api/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/api/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:3000/api/payment/ipn

# Manual BDT Payments (bKash, Nagad, Rocket, Upay)
BKASH_NUMBER=your_bkash_number
BKASH_NUMBER_2=your_bkash_number_2
NAGAD_NUMBER=your_nagad_number
ROCKET_NUMBER=your_rocket_number
UPAY_NUMBER=your_upay_number

# ============================================================================
# RATE LIMITING (requests per minute by plan tier)
# ============================================================================
RATE_LIMIT_FREE=10
RATE_LIMIT_STARTER=60
RATE_LIMIT_PRO=200
RATE_LIMIT_TEAM=1000
RATE_LIMIT_ENTERPRISE=10000

# ============================================================================
# PRICING (INR per 1M tokens) — reference only; live pricing lives in the
# model_pricing table (see database/supabase-seed-pricing.sql)
# ============================================================================
PRICE_DEEPSEEK=0.68
PRICE_LLAMA=0.45
PRICE_GEMINI_FLASH=0.23
PRICE_GPT4O_MINI=0.45
PRICE_CLAUDE_HAIKU=1.89
PRICE_MISTRAL=0.53
PRICE_CLAUDE_SONNET=9.09
PRICE_GPT4O=7.58

# ============================================================================
# SUBSCRIPTION PLANS (INR per month)
# ============================================================================
PLAN_STARTER_PRICE=499
PLAN_STARTER_CREDITS=10000
PLAN_PRO_PRICE=4999
PLAN_PRO_CREDITS=65000
PLAN_TEAM_PRICE=18999
PLAN_TEAM_CREDITS=260000

# ============================================================================
# REFERRAL PROGRAM
# ============================================================================
REFERRAL_COMMISSION_PERCENT=20

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/readypi.log

# ============================================================================
# CORS (Frontend URLs)
# ============================================================================
CORS_ORIGIN=http://localhost:3001,https://readypi.site,https://dashboard.readypi.site

# ============================================================================
# EMAIL (Optional - for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@readypi.site

# ============================================================================
# MONITORING (Optional)
# ============================================================================
SENTRY_DSN=your_sentry_dsn
UPTIMEROBOT_API_KEY=your_uptimerobot_key
